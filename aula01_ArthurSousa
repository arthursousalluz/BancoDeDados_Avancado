CREATE SCHEMA IF NOT EXISTS Funcionarios DEFAULT CHARACTER SET utf8;

USE Funcionarios;

CREATE TABLE IF NOT EXISTS Funcionarios (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100),
    salario DECIMAL(10, 2),
    departamento VARCHAR(100) -- Adicionando a coluna 'departamento' diretamente na criação da tabela
);

