SELECT nome, salario 
FROM Funcionarios 
WHERE salario > 3000;

SELECT nome, salario
FROM Funcionarios
ORDER BY nome ASC;

SELECT 
    COUNT(*) AS Total_funcionarios,
    AVG(salario) AS media_salarial,
    SUM(salario) AS soma_salarios
FROM Funcionarios;


SELECT 
    departamento,
    COUNT(*) AS total_funcionarios,
    AVG(salario) AS media_salarial
FROM Funcionarios 
GROUP BY departamento 
HAVING COUNT(*) > 1;

SELECT nome, salario
FROM Funcionarios
WHERE salario > (
    SELECT AVG(salario) 
    FROM Funcionarios
);

SELECT nome AS Nome, salario AS Salario
FROM Funcionarios;


SELECT nome, salario, departamento
FROM Funcionarios f
WHERE salario > (
    SELECT AVG(salario)
    FROM Funcionarios
    WHERE departamento = f.departamento
);

